// Flax dev cluster — launch every dashboard, agent and tool with zellij.
//
//   Usage:
//     zellij --layout .zellij/dev.kdl
//
//   Port conventions (each package pins its own port so this layout just
//   runs `pnpm dev` with no arguments):
//     dashboard-api  8787   (wrangler dev, --port 8787 in its dev script)
//     dashboard SPA  5173   (vite dev, server.port in vite.config.ts)
//     orchestrator   5199   (vite dev, server.port in vite.config.ts)
//     agents         5201-5215 (vite dev, server.port per vite.config.ts)
//     tools          8801-8837 (wrangler dev, dev.port per wrangler.jsonc)
//
//   Switching tabs (default keybindings):
//     Ctrl-t            enter tab mode
//     h/k or j/l        previous/next tab (arrows work too)
//     1..9              jump straight to a tab
//     Ctrl-t            leave tab mode
//   (In normal mode you can also click the tab names in the tab-bar.)
//
//   Notes:
//   - The global cwd below is absolute on purpose: relative pane cwds are
//     composed pane -> tab -> global cwd, so this layout works no matter where
//     zellij is launched from. Update it if the repo moves.
//   - The tab-bar and status-bar are injected into every tab through
//     default_tab_template (the `children` placeholder). Zellij does not show
//     a tab bar for tab-based layouts unless you add it explicitly.
//   - Local `services` bindings between separate dev processes (e.g. the
//     orchestrator dispatching to coding-agent) only resolve when the
//     referenced worker is reachable at that name; point the orchestrator at
//     the correct agent origin/port or use remote bindings. These panes stream
//     the live logs of every process.

layout {
    cwd "~/Code/flax"

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="dashboard" focus=true {
        pane {
            command "sh"
            args "-c" "sleep 0 && exec pnpm dev"
            cwd "packages/agents/orchestrator-agent"
            name "orchestrator"
        }
        pane {
            command "sh"
            args "-c" "sleep 2 && exec pnpm dev"
            cwd "packages/dashboard-api"
            name "dashboard-api"
        }
        pane {
            command "sh"
            args "-c" "sleep 4 && exec pnpm dev"
            cwd "packages/dashboard"
            name "spa"
        }
    }

    tab name="agents-1" {
        pane {
            command "sh"
            args "-c" "sleep 6 && exec pnpm dev"
            cwd "packages/agents/coding-agent"
            name "coding"
        }
        pane {
            command "sh"
            args "-c" "sleep 8 && exec pnpm dev"
            cwd "packages/agents/code-review-agent"
            name "code-review"
        }
        pane {
