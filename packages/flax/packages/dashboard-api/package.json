{
  "name": "@nowarelabs/dashboard-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "check": "vp check",
    "cf-typegen": "wrangler types --include-runtime=false",
    "build:spa": "pnpm --filter @nowarelabs/dashboard build && rm -rf static && mkdir -p static && cp -r ../dashboard/dist/. static/"
  },
  "dependencies": {
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "bumpp": "^11.0.1",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14",
    "wrangler": "^4.118.0"
  }
}
