{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "security-appsec-agent",
  "account_id": "7aa58cc890267c2dda88943807e3daac",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "traces": {
      "enabled": true,
    },
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "d1_databases": [
    {
      "binding": "FLAX_DB",
      "database_name": "support-agent-db",
      "database_id": "687705ad-bbd5-4e62-84fc-1f9e6b58e9b4",
    },
  ],
  "services": [
    {
      "binding": "SECURITY_SCAN_TOOL",
      "service": "security-scan-tool",
      "entrypoint": "SecurityScanTool",
    },
    {
      "binding": "SBOM_TOOL",
      "service": "sbom-tool",
      "entrypoint": "SbomTool",
    },
    {
      "binding": "PENTEST_TOOL",
      "service": "pentest-tool",
      "entrypoint": "PentestTool",
    },
  ],
  "migrations": [
    {
      "tag": "flue-class-FlueSecurityAppsecAgent",
      "new_sqlite_classes": ["FlueSecurityAppsecAgent"],
    },
  ],
}
