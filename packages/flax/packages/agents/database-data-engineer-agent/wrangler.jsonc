{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "database-data-engineer-agent",
  "account_id": "7aa58cc890267c2dda88943807e3daac",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "traces": {
      "enabled": true,
    },
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "d1_databases": [
    {
      "binding": "FLAX_DB",
      "database_name": "support-agent-db",
      "database_id": "687705ad-bbd5-4e62-84fc-1f9e6b58e9b4",
    },
  ],
  "services": [
    {
      "binding": "DB_CLIENT_TOOL",
      "service": "db-client-tool",
      "entrypoint": "DbClientTool",
    },
    {
      "binding": "MIGRATIONS_TOOL",
      "service": "migrations-tool",
      "entrypoint": "MigrationsTool",
    },
    {
      "binding": "QUERY_PROFILER_TOOL",
      "service": "query-profiler-tool",
      "entrypoint": "QueryProfilerTool",
    },
  ],
  "migrations": [
    {
      "tag": "flue-class-FlueDatabaseDataEngineerAgent",
      "new_sqlite_classes": ["FlueDatabaseDataEngineerAgent"],
    },
  ],
}
