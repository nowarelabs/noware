{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flax-support-agent",
  "account_id": "7aa58cc890267c2dda88943807e3daac",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "FLAX_DB",
      "database_name": "support-agent-db",
      "database_id": "687705ad-bbd5-4e62-84fc-1f9e6b58e9b4"
    }
  ],
  "services": [
    {
      "binding": "JIRA_LINEAR_TOOL",
      "service": "jira-linear-tool",
      "entrypoint": "JiraLinearTool"
    },
    {
      "binding": "SUPPORT_TICKETS_TOOL",
      "service": "support-tickets-tool",
      "entrypoint": "SupportTicketsTool"
    },
    {
      "binding": "SENTIMENT_ANALYSIS_TOOL",
      "service": "sentiment-analysis-tool",
      "entrypoint": "SentimentAnalysisTool"
    },
    {
      "binding": "WEB_SEARCH_TOOL",
      "service": "web-search-tool",
      "entrypoint": "WebSearchTool"
    }
  ],
  "migrations": [
    {
      "tag": "flue-class-FlueIssueTriageAgent",
      "new_sqlite_classes": [
        "FlueIssueTriageAgent"
      ]
    }
  ]
}
